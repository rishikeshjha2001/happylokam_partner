{
  "expo": {
    "name": "happylokam partner",
    "slug": "happylokam-partner",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "happylokampartner",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070a12"
    },
    "ios": {
