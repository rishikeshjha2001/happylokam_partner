      "bundleIdentifier": "com.happylokam.partner",
      "buildNumber": "15"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0052FF"
      },
      "package": "com.happylokam.partner",
      "versionCode": 15,
      "navigationBar": {
        "backgroundColor": "#0d1117",
        "barStyle": "light-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-updates",
        {
          "username": "happylokam"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/c1b2a3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "c1b2a3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d"
      }
    }
  }
}